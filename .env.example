# Copy to .env and fill in. compose.yaml loads this file into the container.

# Required. Get a token by messaging @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=123456:replace-me

# Required. Password for the bundled PostgreSQL database. Pick something
# long and random, using only letters and digits (it goes into a URL).
# It's applied when the database is first created; changing it afterwards
# needs an ALTER USER in psql as well.
POSTGRES_PASSWORD=change-me

# Optional: debug, info (default), warning or error.
LOG_LEVEL=info

# Optional: send Telegram traffic through an outbound proxy.
# HTTPS_PROXY=http://proxy.lan:3128
